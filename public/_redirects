/sender      /.netlify/functions/api/sender           200
/recipient   /.netlify/functions/api/recipient        200
/download    /.netlify/functions/api/download         200
/trace       /.netlify/functions/api/trace            200
/identities/* /.netlify/functions/api/identities/:splat 200
/            /.netlify/functions/api/                 200
/*           /.netlify/functions/api/:splat           200
